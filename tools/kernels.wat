;; Noyaux de calcul du réseau de neurones (src/studio/nn.js) : WebAssembly SIMD (4 flottants à la fois).
;; Assemblés par tools/build_kernels.mjs vers src/studio/kernels-wasm.js. Toutes les adresses sont en octets, les tailles en flottants.
(module
  (memory (export "memory") 256)

  ;; Convolution 1×1 (produit matriciel) : y[oc][p] = b[oc] + Σ_ic w[oc][ic] · x[ic][p]
  ;; x : cin plans de `plane` flottants ; w : cout lignes de cin flottants ; y : cout plans. `plane` multiple de 8, `cout` multiple de 4.
  ;; Quatre canaux de sortie × huit pixels à la fois : 8 accumulateurs, chaque valeur lue est réutilisée.
  (func (export "pw")
    (param $x i32) (param $w i32) (param $b i32) (param $y i32)
    (param $cin i32) (param $cout i32) (param $plane i32)
    (local $oc i32) (local $p i32) (local $ic i32) (local $wi i32) (local $xp i32) (local $yp i32) (local $stride i32) (local $bp i32)
    (local $wp0 i32) (local $wp1 i32) (local $wp2 i32) (local $wp3 i32)
    (local $a0 v128) (local $a1 v128) (local $a2 v128) (local $a3 v128)
    (local $c0 v128) (local $c1 v128) (local $c2 v128) (local $c3 v128)
    (local $xv v128) (local $xw v128) (local $wv v128)
    (local.set $stride (i32.shl (local.get $plane) (i32.const 2)))
    (block $oc_done
      (loop $oc_loop
        (br_if $oc_done (i32.ge_u (local.get $oc) (local.get $cout)))
        (local.set $bp (i32.add (local.get $b) (i32.shl (local.get $oc) (i32.const 2))))
        (local.set $wp0 (i32.add (local.get $w) (i32.shl (i32.mul (local.get $oc) (local.get $cin)) (i32.const 2))))
        (local.set $wp1 (i32.add (local.get $wp0) (i32.shl (local.get $cin) (i32.const 2))))
        (local.set $wp2 (i32.add (local.get $wp1) (i32.shl (local.get $cin) (i32.const 2))))
        (local.set $wp3 (i32.add (local.get $wp2) (i32.shl (local.get $cin) (i32.const 2))))
        (local.set $p (i32.const 0))
        (block $p_done
          (loop $p_loop
            (br_if $p_done (i32.ge_u (local.get $p) (local.get $plane)))
            (local.set $a0 (f32x4.splat (f32.load (local.get $bp))))
            (local.set $a1 (f32x4.splat (f32.load offset=4 (local.get $bp))))
            (local.set $a2 (f32x4.splat (f32.load offset=8 (local.get $bp))))
            (local.set $a3 (f32x4.splat (f32.load offset=12 (local.get $bp))))
            (local.set $c0 (local.get $a0))
            (local.set $c1 (local.get $a1))
            (local.set $c2 (local.get $a2))
            (local.set $c3 (local.get $a3))
            (local.set $xp (i32.add (local.get $x) (i32.shl (local.get $p) (i32.const 2))))
            (local.set $wi (i32.const 0))
            (local.set $ic (local.get $cin))
            (block $ic_done
              (loop $ic_loop
                (br_if $ic_done (i32.eqz (local.get $ic)))
                (local.set $xv (v128.load (local.get $xp)))
                (local.set $xw (v128.load offset=16 (local.get $xp)))
                (local.set $wv (f32x4.splat (f32.load (i32.add (local.get $wp0) (local.get $wi)))))
                (local.set $a0 (f32x4.add (local.get $a0) (f32x4.mul (local.get $xv) (local.get $wv))))
                (local.set $c0 (f32x4.add (local.get $c0) (f32x4.mul (local.get $xw) (local.get $wv))))
                (local.set $wv (f32x4.splat (f32.load (i32.add (local.get $wp1) (local.get $wi)))))
                (local.set $a1 (f32x4.add (local.get $a1) (f32x4.mul (local.get $xv) (local.get $wv))))
                (local.set $c1 (f32x4.add (local.get $c1) (f32x4.mul (local.get $xw) (local.get $wv))))
                (local.set $wv (f32x4.splat (f32.load (i32.add (local.get $wp2) (local.get $wi)))))
                (local.set $a2 (f32x4.add (local.get $a2) (f32x4.mul (local.get $xv) (local.get $wv))))
                (local.set $c2 (f32x4.add (local.get $c2) (f32x4.mul (local.get $xw) (local.get $wv))))
                (local.set $wv (f32x4.splat (f32.load (i32.add (local.get $wp3) (local.get $wi)))))
                (local.set $a3 (f32x4.add (local.get $a3) (f32x4.mul (local.get $xv) (local.get $wv))))
                (local.set $c3 (f32x4.add (local.get $c3) (f32x4.mul (local.get $xw) (local.get $wv))))
                (local.set $xp (i32.add (local.get $xp) (local.get $stride)))
                (local.set $wi (i32.add (local.get $wi) (i32.const 4)))
                (local.set $ic (i32.sub (local.get $ic) (i32.const 1)))
                (br $ic_loop)))
            (local.set $yp (i32.add (local.get $y) (i32.add (i32.mul (local.get $oc) (local.get $stride)) (i32.shl (local.get $p) (i32.const 2)))))
            (v128.store (local.get $yp) (local.get $a0))
            (v128.store offset=16 (local.get $yp) (local.get $c0))
            (v128.store (i32.add (local.get $yp) (local.get $stride)) (local.get $a1))
            (v128.store offset=16 (i32.add (local.get $yp) (local.get $stride)) (local.get $c1))
            (v128.store (i32.add (local.get $yp) (i32.shl (local.get $stride) (i32.const 1))) (local.get $a2))
            (v128.store offset=16 (i32.add (local.get $yp) (i32.shl (local.get $stride) (i32.const 1))) (local.get $c2))
            (v128.store (i32.add (local.get $yp) (i32.mul (local.get $stride) (i32.const 3))) (local.get $a3))
            (v128.store offset=16 (i32.add (local.get $yp) (i32.mul (local.get $stride) (i32.const 3))) (local.get $c3))
            (local.set $p (i32.add (local.get $p) (i32.const 8)))
            (br $p_loop)))
        (local.set $oc (i32.add (local.get $oc) (i32.const 4)))
        (br $oc_loop))))

  ;; Produit matrice × vecteur : y[r] = b[r] + Σ_i w[r][i] · x[i] (k multiple de 4)
  (func (export "gemv")
    (param $x i32) (param $w i32) (param $b i32) (param $y i32) (param $k i32) (param $rows i32)
    (local $r i32) (local $xp i32) (local $wp i32) (local $i i32) (local $acc v128)
    (local.set $wp (local.get $w))
    (block $r_done
      (loop $r_loop
        (br_if $r_done (i32.ge_u (local.get $r) (local.get $rows)))
        (local.set $acc (v128.const i32x4 0 0 0 0))
        (local.set $xp (local.get $x))
        (local.set $i (local.get $k))
        (block $i_done
          (loop $i_loop
            (br_if $i_done (i32.eqz (local.get $i)))
            (local.set $acc (f32x4.add (local.get $acc) (f32x4.mul (v128.load (local.get $xp)) (v128.load (local.get $wp)))))
            (local.set $xp (i32.add (local.get $xp) (i32.const 16)))
            (local.set $wp (i32.add (local.get $wp) (i32.const 16)))
            (local.set $i (i32.sub (local.get $i) (i32.const 4)))
            (br $i_loop)))
        (f32.store (i32.add (local.get $y) (i32.shl (local.get $r) (i32.const 2)))
          (f32.add
            (f32.load (i32.add (local.get $b) (i32.shl (local.get $r) (i32.const 2))))
            (f32.add
              (f32.add (f32x4.extract_lane 0 (local.get $acc)) (f32x4.extract_lane 1 (local.get $acc)))
              (f32.add (f32x4.extract_lane 2 (local.get $acc)) (f32x4.extract_lane 3 (local.get $acc))))))
        (local.set $r (i32.add (local.get $r) (i32.const 1)))
        (br $r_loop))))

  ;; Convolution 3×3 par canal, pas 1 : `in` = ch plans de (h+2) lignes de `pw` flottants (entourés de zéros, pw ≥ ow4 + 2),
  ;; k : ch × 9 poids, b : ch biais, out : ch plans de h lignes de ow4 flottants (ow4 multiple de 4).
  (func (export "dw")
    (param $in i32) (param $k i32) (param $b i32) (param $out i32)
    (param $ch i32) (param $h i32) (param $pw i32) (param $ow4 i32)
    (local $c i32) (local $r i32) (local $p i32) (local $r0 i32) (local $r1 i32) (local $r2 i32) (local $op i32) (local $kp i32) (local $pwb i32)
    (local $k0 v128) (local $k1 v128) (local $k2 v128) (local $k3 v128) (local $k4 v128) (local $k5 v128) (local $k6 v128) (local $k7 v128) (local $k8 v128) (local $bias v128) (local $acc v128)
    (local.set $pwb (i32.shl (local.get $pw) (i32.const 2)))
    (block $c_done
      (loop $c_loop
        (br_if $c_done (i32.ge_u (local.get $c) (local.get $ch)))
        (local.set $kp (i32.add (local.get $k) (i32.mul (local.get $c) (i32.const 36))))
        (local.set $k0 (f32x4.splat (f32.load (local.get $kp))))
        (local.set $k1 (f32x4.splat (f32.load offset=4 (local.get $kp))))
        (local.set $k2 (f32x4.splat (f32.load offset=8 (local.get $kp))))
        (local.set $k3 (f32x4.splat (f32.load offset=12 (local.get $kp))))
        (local.set $k4 (f32x4.splat (f32.load offset=16 (local.get $kp))))
        (local.set $k5 (f32x4.splat (f32.load offset=20 (local.get $kp))))
        (local.set $k6 (f32x4.splat (f32.load offset=24 (local.get $kp))))
        (local.set $k7 (f32x4.splat (f32.load offset=28 (local.get $kp))))
        (local.set $k8 (f32x4.splat (f32.load offset=32 (local.get $kp))))
        (local.set $bias (f32x4.splat (f32.load (i32.add (local.get $b) (i32.shl (local.get $c) (i32.const 2))))))
        (local.set $r (i32.const 0))
        (block $r_done
          (loop $r_loop
            (br_if $r_done (i32.ge_u (local.get $r) (local.get $h)))
            ;; début des trois lignes d'entrée (r, r+1, r+2 dans le plan entouré de zéros)
            (local.set $r0 (i32.add (local.get $in) (i32.mul (i32.add (i32.mul (local.get $c) (i32.add (local.get $h) (i32.const 2))) (local.get $r)) (local.get $pwb))))
            (local.set $r1 (i32.add (local.get $r0) (local.get $pwb)))
            (local.set $r2 (i32.add (local.get $r1) (local.get $pwb)))
            (local.set $op (i32.add (local.get $out) (i32.shl (i32.mul (i32.add (i32.mul (local.get $c) (local.get $h)) (local.get $r)) (local.get $ow4)) (i32.const 2))))
            (local.set $p (i32.const 0))
            (block $p_done
              (loop $p_loop
                (br_if $p_done (i32.ge_u (local.get $p) (local.get $ow4)))
                (local.set $acc (f32x4.add (local.get $bias) (f32x4.mul (local.get $k0) (v128.load (local.get $r0)))))
                (local.set $acc (f32x4.add (local.get $acc) (f32x4.mul (local.get $k1) (v128.load offset=4 (local.get $r0)))))
                (local.set $acc (f32x4.add (local.get $acc) (f32x4.mul (local.get $k2) (v128.load offset=8 (local.get $r0)))))
                (local.set $acc (f32x4.add (local.get $acc) (f32x4.mul (local.get $k3) (v128.load (local.get $r1)))))
                (local.set $acc (f32x4.add (local.get $acc) (f32x4.mul (local.get $k4) (v128.load offset=4 (local.get $r1)))))
                (local.set $acc (f32x4.add (local.get $acc) (f32x4.mul (local.get $k5) (v128.load offset=8 (local.get $r1)))))
                (local.set $acc (f32x4.add (local.get $acc) (f32x4.mul (local.get $k6) (v128.load (local.get $r2)))))
                (local.set $acc (f32x4.add (local.get $acc) (f32x4.mul (local.get $k7) (v128.load offset=4 (local.get $r2)))))
                (local.set $acc (f32x4.add (local.get $acc) (f32x4.mul (local.get $k8) (v128.load offset=8 (local.get $r2)))))
                (v128.store (local.get $op) (local.get $acc))
                (local.set $r0 (i32.add (local.get $r0) (i32.const 16)))
                (local.set $r1 (i32.add (local.get $r1) (i32.const 16)))
                (local.set $r2 (i32.add (local.get $r2) (i32.const 16)))
                (local.set $op (i32.add (local.get $op) (i32.const 16)))
                (local.set $p (i32.add (local.get $p) (i32.const 4)))
                (br $p_loop)))
            (local.set $r (i32.add (local.get $r) (i32.const 1)))
            (br $r_loop)))
        (local.set $c (i32.add (local.get $c) (i32.const 1)))
        (br $c_loop))))

  ;; PReLU en place : x[c][i] = max(x, 0) + slope[c] · min(x, 0), ch plans de `plane` flottants (plane multiple de 4)
  (func (export "prelu")
    (param $x i32) (param $slope i32) (param $ch i32) (param $plane i32)
    (local $c i32) (local $i i32) (local $p i32) (local $s v128) (local $v v128) (local $zero v128)
    (local.set $zero (v128.const i32x4 0 0 0 0))
    (local.set $p (local.get $x))
    (block $c_done
      (loop $c_loop
        (br_if $c_done (i32.ge_u (local.get $c) (local.get $ch)))
        (local.set $s (f32x4.splat (f32.load (i32.add (local.get $slope) (i32.shl (local.get $c) (i32.const 2))))))
        (local.set $i (i32.const 0))
        (block $i_done
          (loop $i_loop
            (br_if $i_done (i32.ge_u (local.get $i) (local.get $plane)))
            (local.set $v (v128.load (local.get $p)))
            (v128.store (local.get $p)
              (f32x4.add (f32x4.max (local.get $v) (local.get $zero)) (f32x4.mul (local.get $s) (f32x4.min (local.get $v) (local.get $zero)))))
            (local.set $p (i32.add (local.get $p) (i32.const 16)))
            (local.set $i (i32.add (local.get $i) (i32.const 4)))
            (br $i_loop)))
        (local.set $c (i32.add (local.get $c) (i32.const 1)))
        (br $c_loop))))
)
