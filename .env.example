# Railway : ajouter ces variables dans l'onglet Variables du service.
# DATABASE_URL est fournie automatiquement si tu ajoutes le plugin Postgres
# et que tu la références : ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://app:app@localhost:5432/atildita

# Mot de passe de l'interface /admin (vide ou « change-me… » : admin désactivée)
ADMIN_PASSWORD=
# Chaîne aléatoire longue (signature du cookie de session), par exemple :
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Clé API Supadata : récupération des transcriptions (1 crédit par vidéo, sous-titres existants uniquement).
# Optionnelle : sans elle, on peut coller une transcription à la main dans l'admin.
SUPADATA_API_KEY=

# Clé « YouTube Data API v3 » (Google Cloud, gratuite) : lister les vidéos d'une chaîne
# pour la synchronisation automatique. Optionnelle.
YOUTUBE_API_KEY=

# Clé API OpenRouter : traduit automatiquement une transcription quand sa langue ne correspond
# pas à celle demandée (ex. « fr » demandé, sous-titres seulement en anglais). Optionnelle.
OPENROUTER_API_KEY=
# Modèle de traduction (identifiant OpenRouter, voir https://openrouter.ai/models).
# TRANSLATE_MODEL=google/gemini-2.5-flash-lite

# Résumés des vidéos : rédigés automatiquement en arrière-plan pour chaque vidéo transcrite, puis stockés en base
# (consultables dans l'admin). Utilise OPENROUTER_API_KEY ; le modèle par défaut
# est GPT (openai/gpt-4.1-mini). Pause et relance depuis Admin → Synchronisation.
# SUMMARY_MODEL=openai/gpt-4.1-mini   # modèle des résumés (par défaut : openai/gpt-4.1-mini, comme les extraits ; indépendant de TRANSLATE_MODEL)
# SUMMARY_DAILY_CAP=500      # résumés générés par jour au maximum (coût borné)
# SUMMARY_PER_CYCLE=5        # résumés générés par passe (une passe toutes les 2 minutes)
# SUMMARY_AUTO=false         # désactive la génération automatique

# Réglages de la synchronisation (valeurs par défaut)
# SYNC_ENABLED=true          # false : désactive le planificateur
# SYNC_INTERVAL_HOURS=24     # fréquence de détection des nouvelles vidéos
# SYNC_BATCH=25              # transcriptions demandées par passe (une passe toutes les 5 min)

# Studio de clips TikTok / Reels : fichiers vidéo déposés dans l'admin (sur Railway : volume monté sur /data).
# STORAGE_DIR=/data/storage      # par défaut ./data ; il faut ffmpeg/ffprobe installés (sur Railway : NIXPACKS_APT_PKGS=ffmpeg)
# MAX_VIDEO_MB=1500              # taille maximale d'un fichier vidéo déposé
# CLIP_MODEL=openai/gpt-4.1-mini   # modèle qui propose les extraits (par défaut : openai/gpt-4.1-mini, sans raisonnement ; indépendant du modèle des résumés).
#                                    # Moins cher : google/gemini-2.5-flash-lite. Évite les modèles « à raisonnement » (deepseek…).
# PIXABAY_API_KEY=               # clé gratuite (https://pixabay.com/api/docs/) : images libres de droits du studio (b-roll) ; sans clé, la section images est désactivée
# PEXELS_API_KEY=                # ou clé Pexels (Pexels n'ouvre plus de nouvelles clés pour l'instant)
# STOCK_PROVIDER=pixabay         # choix du fournisseur quand les deux clés sont là (par défaut : Pixabay)
# STOCK_SEARCHES_PER_HOUR=60     # recherches d'images par visiteur et par heure
# STOCK_DOWNLOADS_PER_HOUR=120   # images téléchargées par visiteur et par heure
# CLIP_MIN_S=15                  # durée minimale d'un extrait (secondes)
# CLIP_MAX_SUGGESTIONS=20        # nombre maximal d'extraits proposés par vidéo
# CLIP_MAX_S=60                  # durée maximale d'un extrait (secondes)
# STUDIO_CONCURRENCY=1           # clips créés en même temps (augmenter si le serveur a plusieurs cœurs)
# STUDIO_MAX_QUEUE=10            # clips en attente au maximum avant de refuser les nouvelles demandes
# STUDIO_RENDERS_PER_HOUR=8      # clips par visiteur et par heure
# STUDIO_PREVIEWS_PER_HOUR=60    # aperçus de cadrage par visiteur et par heure
# STUDIO_PREVIEW_QUEUE=20        # aperçus en attente au maximum avant de refuser (503)
# STUDIO_FRAMING_PER_HOUR=600    # calculs de cadrage automatique par visiteur et par heure
# STUDIO_FILE_MAX_FACTOR=10      # volume servi par clip au maximum, en multiple de sa taille
# STUDIO_FACES=off               # coupe le cadrage automatique sur le visage (détection des visages dans les interviews)
# STUDIO_PREVIEW_FORMAT=webm     # tests seulement : aperçu en WebM pour un navigateur sans H.264

# --- Téléchargement automatique des interviews (yt-dlp) : voir la section du README ---
# AUTO_DOWNLOAD=on               # télécharge les vidéos synchronisées et transcrites (désactivé par défaut)
# AUTO_DOWNLOAD_MIN_S=600        # durée minimale (format long seulement), en secondes
# AUTO_DOWNLOAD_MAX_HEIGHT=720   # définition maximale
# AUTO_DOWNLOAD_MIN_FREE_MB=1500 # pas de téléchargement sous cet espace libre sur le volume
# AUTO_DOWNLOAD_TIMEOUT_MIN=60   # durée maximale d'un téléchargement
# AUTO_ENABLE_CLIPS=off          # ne pas autoriser les clips automatiquement après le téléchargement
# VIDEO_RETENTION_DAYS=90        # les fichiers téléchargés par le site sont supprimés après N jours (jamais ceux déposés à la main)
# YTDLP_PROXY=http://user:motdepasse@hote:port   # proxy si YouTube bloque le serveur
# YTDLP_COOKIES_FILE=/data/cookies.txt           # cookies YouTube (format Netscape) si besoin
# YTDLP_PATH=                    # exécutable yt-dlp imposé (sinon installé et mis à jour tout seul sur le volume)
# YTDLP_JS_RUNTIME=node          # moteur JavaScript pour yt-dlp ; « off » pour ne pas en passer

# --- Accès réservé aux adhérents Nouvelle Énergie (SSO OpenID Connect de NE ; doc : espace adhérents → Initiatives → Connexion) ---
# Les identifiants sont remis par l'équipe numérique de NE après validation de la demande (secret par lien à usage unique).
# MEMBERS_ONLY=on                # réserve le studio aux adhérents ; sans cette ligne, le studio reste ouvert. Activé sans configuration : tout est fermé (503)
# OIDC_CLIENT_ID=                # identifiant du client
# OIDC_CLIENT_SECRET=            # secret du client (variable d'environnement de l'hébergement, jamais dans le dépôt)
# PUBLIC_URL=https://lisnardfacts.fr   # adresse publique : forme les adresses de retour https://…/api/auth/callback (à déclarer à NE, exactes)
# OIDC_ISSUER=https://auth.unenouvelleenergie.fr/realms/nouvelle-energie
# OIDC_SCOPE="openid adherent"   # scopes demandés (le scope e-mail n'est pas demandé : le site n'en a pas besoin)
# MEMBERS_SESSION_DAYS=7         # durée de la session d'un adhérent (1 à 90 jours) ; l'adhésion est revérifiée à chaque reconnexion

# --- Uniquification des clips de la bibliothèque : chaque personne qui télécharge un clip reçoit son propre fichier
#     (deuxième passe ffmpeg avec des micro-transforms invisibles : couleur, micro-recadrage, grain, pitch de ±10 cents au plus).
#     Le seed est dérivé du (clip, personne) : la même personne re-télécharge le même fichier, l’autre en obtient un différent. ---
# LIBRARY_UNIQ=on                # off : servir le clip tel quel (pas de deuxième passe)
# LIBRARY_UNIQ_LEVEL=gentle      # gentle (défaut, couleur ≤ 2,5 %) ou medium (plus marqué : saturation ≤ 4,5 %, pitch ±17 cents)
# LIBRARY_UNIQ_MAX_PER_CLIP=25   # versions uniques gardées par clip (les plus anciennes sont éjectées)
# LIBRARY_UNIQ_CONCURRENCY=1     # versions préparées en parallèle (séparé de la file de rendu du studio)
# LIBRARY_UNIQ_QUEUE=10          # versions en attente avant repli sur le fichier original
# LIBRARY_UNIQ_RETRY_MS=5000     # écart minimal entre deux tentatives après un échec (3 tentatives au plus)

# --- Bibliothèque de clips (/bibliotheque/) : clips publiés depuis le studio ---
# LIBRARY_ENABLED=false          # coupe la bibliothèque
# OWNER_KEY_SECRET=              # secret des empreintes de propriétaires (16+ caractères) ; sans lui, SESSION_SECRET est utilisé
# LIBRARY_RETENTION_DAYS=30      # vidéos gardées N jours, puis archivées (les réglages restent, « Recréer » refait la vidéo)
# LIBRARY_MAX_MB=1500            # place totale des vidéos de la bibliothèque sur le volume
# LIBRARY_MIN_FREE_MB=500        # refuse de publier sous ce seuil d'espace libre
# LIBRARY_MAX_PER_OWNER=30       # vidéos gardées par personne
# LIBRARY_PUBLISH_PER_HOUR=20    # publications par personne et par heure
# LIBRARY_AUTOHIDE_REPORTS=5     # masquage automatique à N signalements (0 : jamais)
# LIBRARY_BYTES_PER_HOUR_MB=2000 # volume de vidéos servi par connexion et par heure

# --- Mur des clips : les TikToks du hashtag suivi, récupérés avec Apify (acteur clockworks/tiktok-scraper) ---
# APIFY_TOKEN=apify_api_...      # jeton personnel Apify (Settings → API & Integrations) ; sans lui, le mur reste vide
# WALL_HASHTAG=lisnard2027       # hashtag suivi (sans le #)
# WALL_MAX=13                    # le mur montre les N meilleurs clips (3 à 60)
# WALL_RESULTS=100               # vidéos demandées à chaque actualisation (10 à 1000) : environ 1,70 $ pour 1 000 résultats
# WALL_REFRESH_HOURS=24          # actualisation automatique toutes les N heures (0 : seulement à la demande dans l'admin)
# WALL_WEIGHTS=1,10,50           # score du classement = vues × 1 + j'aime × 10 + commentaires × 50
# WALL_ENABLED=false             # coupe le mur
# APIFY_TIKTOK_ACTOR=clockworks/tiktok-scraper   # autre acteur compatible si besoin
